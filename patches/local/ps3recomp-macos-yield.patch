+/* The runtime's yield (Sleep(0), SwitchToThread, the SPU lock-line spin).
+ * On macOS sched_yield is swtch_pri(0), which also depresses the caller's
+ * priority for a scheduler quantum: with more runnable threads than cores
+ * (main, RSX walker, SPU lanes) a thread that yields while waiting for a
+ * spinlock can then sit out ~10 ms. thread_switch with no option hands the
+ * CPU over without the depression. RACACIT_YIELD=sched restores sched_yield. */
+#ifdef __APPLE__
+#include <mach/mach.h>
+#include <mach/thread_switch.h>
+#endif
+void racacit_yield(void)
+{
+#ifdef __APPLE__
+    static int mode = -1;
+    if (mode < 0) { const char* e = getenv("RACACIT_YIELD"); mode = (e && !strcmp(e, "sched")) ? 0 : 1; }
+    if (mode) { thread_switch(MACH_PORT_NULL, SWITCH_OPTION_NONE, 0); return; }
+#endif
+    sched_yield();
+}
